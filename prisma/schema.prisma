generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  ingredients String?     @db.Text
  howToUse    String?     @db.Text
  routine     String?     @db.Text
  cautions    String?     @db.Text
  price       Float
  salePrice   Float?
  images      String[]
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  categories  Category[]  @relation("ProductCategories")
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Skin quiz recommendation-engine metadata: which routine step this
  // product belongs in, and which safety-exclusion tags it carries
  // (e.g. "retinoid", "aha", "high-vitc").
  quizStep    String?
  quizTags    String[]    @default([])
  // Products sharing a non-null group key are interchangeable — the quiz
  // presents them as an either/or choice (e.g. DayCare vs Day Beauty
  // Radiance) instead of prescribing both.
  quizAltGroup String?
  // Explicit, admin-controlled Kentelle usage instruction — overrides the
  // old tag-based AM/PM guess (e.g. actives are not assumed to be Night-only;
  // Glycolic 10 is normally DAY). One of "DAY" | "NIGHT" | "DAY_NIGHT" |
  // "SPECIAL" (special / prescribed-days only). Null falls back to the tag
  // heuristic so existing untagged products keep working.
  quizRoutineTiming String?
  // Optional override for the starting-frequency copy shown in the
  // prescription (e.g. "1–2x weekly, increase per tolerance"). Falls back
  // to the tag-based default when unset.
  quizFrequency     String?
  // Other product ids this product should be paired with / layered with —
  // shown as "Pair with" guidance on the prescription card.
  quizPairWithIds   String[]    @default([])
  // Concern keys (matching QuizConcern.key) this product is Kentelle's best
  // match for — a direct product-to-concern link the owner can set without
  // touching the question/option builder.
  quizBestMatchTags String[]    @default([])
  // Concern keys this product should be offered as a lower-priority
  // alternative for, rather than the best match.
  quizAlternativeForTags String[] @default([])
  // Owner-controlled storefront + quiz availability: shown as a "Coming
  // Soon" badge and excluded from purchase / quiz recommendations until
  // turned off.
  comingSoon        Boolean     @default(false)

  @@index([slug])
  @@index([isActive])
  @@index([price])
}

model Category {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String?   @db.Text
  tagline           String?
  image             String?
  sortOrder         Int       @default(0)
  showInCollections Boolean   @default(true)
  products          Product[] @relation("ProductCategories")

  @@index([slug])
}

model SkinConcern {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  icon      String?
  sortOrder Int    @default(0)
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  guestEmail      String?
  items           OrderItem[]
  subtotal        Float
  shippingCost    Float       @default(0)
  total           Float
  status          OrderStatus @default(PENDING)
  paymentId       String?
  paypalOrderId   String?
  shippingAddress Json
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  image     String
  price     Float
  quantity  Int

  @@index([orderId])
}

model Customer {
  id               String   @id @default(cuid())
  supabaseUid      String?  @unique
  name             String
  email            String   @unique
  phone            String?
  addresses        Json[]
  orders           Order[]
  proStatus        String?  // "retail" | "pending" | "approved"
  proDocUrl        String?
  proTrainingAck   Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([supabaseUid])
  @@index([proStatus])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([reviewed])
  @@index([createdAt])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  body         String   @db.Text
  productName  String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([approved])
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  body            String    @db.Text
  coverImage      String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  // WordPress-style fields
  status          String    @default("draft")  // draft | published | trashed
  postType        String    @default("blog")   // blog | glossary | tutorial
  seoTitle        String?
  seoDescription  String?   @db.Text
  focusKeyword    String?
  tags            String[]
  categories      String[]
  authorName      String?
  authorAvatarUrl String?
  authorBio       String?   @db.Text
  readingTime     Int?
  isFeatured      Boolean   @default(false)
  revisions       Json?

  @@index([slug])
  @@index([published])
  @@index([status])
  @@index([postType])
}

model Routine {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  tagline   String?
  category  String   // "routine" | "clinical"
  steps     Json
  tips      Json?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

model QuizSubmission {
  id        String   @id @default(cuid())
  email     String?
  name      String?
  concerns  String[]
  responses Json
  routine   Json?
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model QuizConcern {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  note      String?
  poolKey   String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
}

model QuizQuestion {
  id          String       @id @default(cuid())
  poolKey     String
  prompt      String       @db.Text
  subtitle    String?
  why         String?      @db.Text
  type        String       @default("single")
  placeholder String?
  sortOrder   Int          @default(0)
  enabled     Boolean      @default(true)
  options     QuizOption[]

  @@index([poolKey])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  label      String
  note       String?
  sortOrder  Int          @default(0)
  productIds String[]     @default([])
  flags      String[]     @default([])

  @@index([questionId])
}

// Defines what a safety/behaviour flag (set by a QuizOption) actually does
// to the recommendation engine — which catalog tag it excludes, or which
// product it substitutes in. Admin-editable so new exclusion rules can be
// added without a code change.
model QuizFlagRule {
  id                  String  @id @default(cuid())
  flag                String
  label               String
  excludesTag         String?
  substituteProductId String?
  note                String? @db.Text
  sortOrder           Int     @default(0)

  @@index([flag])
}

model QuizSettings {
  id                String  @id @default("singleton")
  coreCleanserId    String?
  coreTonerId       String?
  coreTreatmentId   String?
  coreMoisturiserId String?
  maxTreatments     Int     @default(5)
}

// Automatic basket-value discount tiers ("spend $X, get Y% off") — owner
// editable, no discount code required. Applies to the whole cart subtotal
// unless eligibleCategoryIds is set, in which case only those categories'
// line items count toward the threshold.
model CartDiscountTier {
  id                  String   @id @default(cuid())
  label               String?
  threshold           Float
  percent             Float
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  eligibleCategoryIds String[] @default([])

  @@index([active])
}

model CartDiscountSettings {
  id                     String  @id @default("singleton")
  enabled                Boolean @default(true)
  // If false, an applied coupon code takes precedence and the automatic
  // tier discount is suppressed rather than stacked.
  combinableWithCoupons  Boolean @default(false)
  freeShippingEligible   Boolean @default(true)
}

model Content {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         String @default("editor")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
